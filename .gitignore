# Ignore IDE related files
/.idea
/.vs
/.vscode

# Ignore build directories
/build
/build-*
/cmake-build-debug
/cmake-build-release
/cmake-build-relwithdebinfo
/out

# Ignore CMake user preset files
CMakeUserPresets.json

# Ignore CMake settings files generated by Visual Studio
CMakeSettings.json

# OpenCode stuff
/.opencode/plans

# macOS system files
.DS_Store

# Generated per machine at first run (private keys must never be committed)
/resources/*.pem
